{
    "_comment": "========== RulE-SSRL Split Approach Config for WN18RR ==========",
    "_comment_mode": "Three-stage pipeline: Phase1 Pre-training -> Phase2 Policy Network Training -> Phase3 Fusion Testing",

    "_comment_data": "========== Data Configuration ==========",
    "data_path": "../data/wn18rr",
    "rule_file": "../data/wn18rr/mined_rules.txt",
    "cuda": true,
    "cpu_num": 10,
    "seed": 800,

    "_comment_phase1": "========== Phase 1: Pre-training Configuration (KGE + Rule Only) ==========",
    "batch_size": 512,
    "negative_sample_size": 1024,
    "rule_batch_size": 256,
    "rule_negative_size": 128,
    "hidden_dim": 500,
    "gamma_fact": 6.0,
    "gamma_rule": 2.0,
    "negative_adversarial_sampling": true,
    "adversarial_temperature": 0.5,
    "uni_weight": false,
    "learning_rate": 5e-05,
    "warm_up_steps": null,
    "regularization": 0.1,
    "disable_adv": false,
    "p_norm": 2,
    "save_checkpoint_steps": 10,
    "valid_steps": 1000,
    "log_steps": 100,
    "weight_rule": 0.5,
    "max_steps": 60000,
    "init_checkpoint": null,
    "save_path": "wn18rr_SSRL",
    "weight_decay": 0,

    "_comment_grounding": "========== Grounding Configuration (used by original RulE mode, not used by SSRL mode) ==========",
    "mlp_rule_dim": 16,
    "smoothing": 0.3,
    "batch_per_epoch": 1000000,
    "print_every": 1000,
    "g_batch_size": 32,
    "g_lr": 0.005,
    "num_iters": 20,

    "_comment_phase2": "========== Phase 2: Policy Network Training ==========",
    "use_policy_network": true,
    "max_num_actions": 200,
    "policy_hidden_dim": 256,

    "_comment_method_switch": "Method Selection (false=KL Divergence, true=Policy Gradient)",
    "use_policy_gradient": false,

    "_comment_common": "Common Parameters (Both Methods)",
    "policy_num_iters": 10,
    "policy_batch_size": 64,
    "policy_lr": 0.0001,
    "policy_log_steps": 1,
    "policy_eval_every": 3,
    "max_path_length": 4,
    "lambda_rule": 0.2,

    "_comment_kl_params": "KL Divergence Specific Parameters",
    "kl_num_rollouts": 3,

    "_comment_pg_params": "Policy Gradient Specific Parameters",
    "pg_num_rollouts": 5,
    "gamma": 0.99,
    "baseline": "avg_reward_normalized",
    "entropy_weight": 0.01,
    "grad_clip_norm": 5.0,
    "use_lr_scheduler": true,
    "lr_decay_factor": 0.5,
    "lr_decay_steps": 10,

    "_comment_inference": "Inference Parameters",
    "rule_bonus_coef": 0.1,
    "rule_bonus_default": 0.05,

    "_comment_phase3": "========== Phase 3: Testing Configuration (KGE + Policy Fusion) ==========",
    "use_kge_fusion": true,
    "beam_size": 50,
    "dev_batch_size": 64,
    "alpha": 1.0,
    "beta": 2.0
}

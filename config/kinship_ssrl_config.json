{
    "_comment": "========== RulE-SSRL Configuration for Kinship ==========",
    "_comment_mode": "Three-phase pipeline: Phase1 Pre-training -> Phase2 Policy Network Training -> Phase3 Fusion Testing",

    "_comment_data": "========== Data Configuration ==========",
    "data_path": "../data/kinship",
    "rule_file": "../data/kinship/mined_rules.txt",
    "cuda": true,
    "cpu_num": 10,
    "seed": 800,

    "_comment_phase1": "========== Phase 1: Pre-training (KGE + Rule Embedding) ==========",
    "batch_size": 256,
    "negative_sample_size": 512,
    "rule_batch_size": 256,
    "rule_negative_size": 128,
    "hidden_dim": 2000,
    "gamma_fact": 6,
    "gamma_rule": 8,
    "negative_adversarial_sampling": true,
    "adversarial_temperature": 0.25,
    "uni_weight": false,
    "learning_rate": 0.0001,
    "warm_up_steps": null,
    "regularization": 0,
    "disable_adv": false,
    "p_norm": 2,
    "save_checkpoint_steps": 10,
    "valid_steps": 1000,
    "log_steps": 100,
    "weight_rule": 1,
    "max_steps": 30000,
    "init_checkpoint": null,
    "save_path": "kinship_SSRL",
    "weight_decay": 0,

    "_comment_grounding": "========== Grounding Configuration (Original RulE Mode) ==========",
    "mlp_rule_dim": 100,
    "smoothing": 0.2,
    "batch_per_epoch": 1000000,
    "print_every": 10,
    "g_batch_size": 16,
    "g_lr": 0.0001,
    "num_iters": 20,

    "_comment_phase2": "========== Phase 2: Policy Network Training (Random Rollout) ==========",
    "use_policy_network": true,
    "max_num_actions": 200,
    "policy_hidden_dim": 128,
    "policy_num_iters": 10,
    "policy_batch_size": 64,
    "policy_lr": 0.0001,
    "policy_log_steps": 5,
    "max_path_length": 4,
    "policy_num_rollouts": 3,
    "policy_eval_every": 3,

    "_comment_reward": "========== Reward Weights (Training & Inference) ==========",
    "lambda_rule": 0.2,
    "_lambda_rule_desc": "Training: Rule reward weight in 'reward = target + lambda_rule * rule'. Range: 0.2-0.5. Higher = more rule guidance.",
    "rule_bonus_coef": 0.1,
    "_rule_bonus_coef_desc": "Inference: Rule bonus coefficient in 'final_score = base_score + rule_bonus_coef * rule_match'. Range: 0.05-0.3. Lower = less rule influence.",
    "rule_bonus_default": 0.05,
    "_rule_bonus_default_desc": "Inference: Default rule bonus when no rule applies. Range: 0.01-0.1. Should be smaller than rule_bonus_coef.",

    "_comment_phase3": "========== Phase 3: Testing (KGE + Policy Fusion with Beam Search) ==========",
    "use_kge_fusion": true,
    "beam_size": 15,
    "dev_batch_size": 64,
    "alpha": 1,
    "beta": 2
}

{
    "data_path": "../data/umls",
    "rule_file": "../data/umls/mined_rules.txt",
    "cuda": true,
    "cpu_num": 10,
    "seed": 800,
    "batch_size": 256,
    "negative_sample_size": 512,
    "rule_batch_size": 256,
    "rule_negative_size": 128,
    "hidden_dim": 2000,
    "gamma_fact": 6,
    "gamma_rule": 8,
    "negative_adversarial_sampling": true,
    "adversarial_temperature": 0.25,
    "uni_weight": false,
    "learning_rate": 0.0001,
    "warm_up_steps": null,
    "save_checkpoint_steps": 10,
    "valid_steps": 1000,
    "log_steps": 100,
    "weight_rule": 1,
    "max_steps": 30000,
    "init_checkpoint": null,
    "save_path": "umls",
    "mlp_rule_dim": 100,
    "alpha": 2.0,
    "regularization": 0,
    "disable_adv": false,
    "p_norm": 2,
    "smoothing": 0.2,
    "batch_per_epoch": 1000000,
    "print_every": 10,
    "g_batch_size": 16,
    "g_lr": 0.0001,
    "weight_decay": 0,
    "num_iters": 15,
    "num_samples": 5,
    "beta_kl": 0.001,
    "beta_sigma": 0.001,
    "lambda_0": 1.0,
    "lambda_uncertainty": 0.001,

    "use_hierarchical_agg": true,
    "quality_thresholds": [0.4, 0.7],
    "hierarchical_hidden_dim": 64,
    "hierarchical_dropout": 0.1,

    "use_dynamic_alpha": true,
    "dynamic_alpha_min": 0.0,
    "dynamic_alpha_max": 2.0,
    "dynamic_alpha_margin_weight": 5.0,
    "dynamic_alpha_entropy_weight": 2.0,
    "dynamic_alpha_bias": 0.0,
    "dynamic_alpha_topk": 50
}

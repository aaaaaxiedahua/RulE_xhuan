{
    "_comment": "========== RulE-SSRL Configuration for FB15k-237 ==========",
    "_comment_mode": "use_policy_network=true enables RulE-SSRL mode with policy network",

    "_comment_data": "========== Data Configuration ==========",
    "data_path": "../data/FB15k-237",
    "rule_file": "../data/FB15k-237/mined_rules.txt",
    "cuda": true,
    "cpu_num": 10,
    "seed": 800,

    "_comment_pretraining": "========== Pre-training Configuration (KGE + Rule + Policy) ==========",
    "batch_size": 1024,
    "negative_sample_size": 256,
    "rule_batch_size": 128,
    "rule_negative_size": 64,
    "hidden_dim": 1000,
    "gamma_fact": 9.0,
    "gamma_rule": 9.0,
    "disable_adv": false,
    "negative_adversarial_sampling": true,
    "adversarial_temperature": 1.0,
    "uni_weight": false,
    "learning_rate": "5e-05",
    "warm_up_steps": null,
    "regularization": 0,
    "save_checkpoint_steps": 10,
    "valid_steps": 1000,
    "log_steps": 100,
    "p_norm": 2,
    "weight_rule": 3,
    "max_steps": 100000,
    "init_checkpoint_config": null,
    "save_path": "FB15k237_SSRL",
    "weight_decay": 0,

    "_comment_grounding": "========== Grounding Configuration (NOT USED in RulE-SSRL) ==========",
    "_comment_grounding_note": "These parameters are ignored when use_policy_network=true",
    "mlp_rule_dim": 16,
    "alpha": 3.0,
    "smoothing": 0.2,
    "batch_per_epoch": 1000000,
    "print_every": 1000,
    "g_batch_size": 32,
    "g_lr": 0.005,
    "g_warm_up_steps": null,
    "num_iters": 20,

    "_comment_ssrl": "========== RulE-SSRL Policy Network Configuration ==========",
    "use_policy_network": true,
    "policy_hidden_dim": 256,
    "policy_batch_size": 32,
    "weight_policy": 0.5,
    "num_policy_samples": 10,
    "max_path_length": 3,

    "_comment_rl_finetuning": "========== Optional RL Finetuning Phase ==========",
    "enable_rl_finetuning": false,
    "rl_finetuning_steps": 10000,
    "rl_finetuning_lr": 0.0001,
    "rl_log_steps": 100
}

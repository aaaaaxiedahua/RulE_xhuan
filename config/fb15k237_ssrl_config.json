{
    "_comment": "========== RulE-SSRL拆分方案配置 for FB15k-237 ==========",
    "_comment_mode": "三阶段流程: Phase1预训练 -> Phase2策略网络训练 -> Phase3融合测试",

    "_comment_data": "========== 数据配置 ==========",
    "data_path": "../data/FB15k-237",
    "rule_file": "../data/FB15k-237/mined_rules.txt",
    "cuda": true,
    "cpu_num": 10,
    "seed": 800,

    "_comment_phase1": "========== Phase 1: 预训练配置 (只有KGE + Rule) ==========",
    "batch_size": 1024,
    "negative_sample_size": 256,
    "rule_batch_size": 128,
    "rule_negative_size": 64,
    "hidden_dim": 1000,
    "gamma_fact": 9.0,
    "gamma_rule": 9.0,
    "negative_adversarial_sampling": true,
    "adversarial_temperature": 1.0,
    "uni_weight": false,
    "learning_rate": 5e-05,
    "warm_up_steps": null,
    "regularization": 0,
    "disable_adv": false,
    "p_norm": 2,
    "save_checkpoint_steps": 10,
    "valid_steps": 1000,
    "log_steps": 100,
    "weight_rule": 3,
    "max_steps": 100000,
    "init_checkpoint": null,
    "save_path": "FB15k237_SSRL",
    "weight_decay": 0,

    "_comment_grounding": "========== Grounding配置 (原始RulE模式使用) ==========",
    "mlp_rule_dim": 16,
    "smoothing": 0.2,
    "batch_per_epoch": 1000000,
    "print_every": 1000,
    "g_batch_size": 32,
    "g_lr": 0.005,
    "num_iters": 20,

    "_comment_phase2": "========== Phase 2: 策略网络训练配置 ==========",
    "use_policy_network": true,
    "max_num_actions": 200,
    "policy_hidden_dim": 256,
    "policy_num_iters": 20,
    "policy_batch_size": 64,
    "policy_lr": 0.0001,
    "policy_log_steps": 100,
    "max_path_length": 4,
    "policy_num_rollouts": 3,
    "policy_eval_every": 3,

    "_comment_phase3": "========== Phase 3: 测试配置 (KGE + Policy 融合) ==========",
    "use_kge_fusion": true,
    "beam_size": 30,
    "dev_batch_size": 64,
    "alpha": 1,
    "beta": 2
}

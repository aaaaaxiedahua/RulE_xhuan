{
    "_comment": "========== RulE-SSRL Configuration for UMLS ==========",
    "_comment_mode": "UMLS is a small dataset (135 entities) - good for quick testing",

    "_comment_data": "========== Data Configuration ==========",
    "data_path": "../data/umls",
    "rule_file": "../data/umls/mined_rules.txt",
    "cuda": true,
    "cpu_num": 10,
    "seed": 800,

    "_comment_pretraining": "========== Pre-training Configuration (KGE + Rule + Policy) ==========",
    "batch_size": 256,
    "negative_sample_size": 512,
    "rule_batch_size": 256,
    "rule_negative_size": 128,
    "hidden_dim": 2000,
    "gamma_fact": 6,
    "gamma_rule": 8,
    "negative_adversarial_sampling": true,
    "adversarial_temperature": 0.25,
    "uni_weight": false,
    "learning_rate": 0.0001,
    "warm_up_steps": null,
    "regularization": 0,
    "disable_adv": false,
    "p_norm": 2,
    "save_checkpoint_steps": 10,
    "valid_steps": 1000,
    "log_steps": 100,
    "weight_rule": 1,
    "max_steps": 30000,
    "init_checkpoint": null,
    "save_path": "umls_SSRL",
    "weight_decay": 0,

    "_comment_grounding": "========== Grounding Configuration (NOT USED in RulE-SSRL) ==========",
    "_comment_grounding_note": "These parameters are ignored when use_policy_network=true",
    "mlp_rule_dim": 100,
    "alpha": 2.0,
    "smoothing": 0.2,
    "batch_per_epoch": 1000000,
    "print_every": 10,
    "g_batch_size": 16,
    "g_lr": 0.0001,
    "num_iters": 20,

    "_comment_ssrl": "========== RulE-SSRL Policy Network Configuration ==========",
    "use_policy_network": true,
    "max_num_actions": 200,
    "policy_hidden_dim": 128,
    "policy_batch_size": 16,
    "weight_policy": 0.3,
    "num_policy_samples": 5,
    "max_path_length": 3,

    "_comment_rl_finetuning": "========== Optional RL Finetuning Phase ==========",
    "enable_rl_finetuning": false,
    "rl_finetuning_steps": 5000,
    "rl_finetuning_lr": 0.0001,
    "rl_log_steps": 100
}

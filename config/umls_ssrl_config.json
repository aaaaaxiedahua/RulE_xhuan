{
    "_comment": "========== RulE-SSRL拆分方案配置 for UMLS ==========",
    "_comment_mode": "三阶段流程: Phase1预训练 -> Phase2策略网络训练 -> Phase3融合测试",

    "_comment_data": "========== 数据配置 ==========",
    "data_path": "../data/umls",
    "rule_file": "../data/umls/mined_rules.txt",
    "cuda": true,
    "cpu_num": 10,
    "seed": 800,

    "_comment_phase1": "========== Phase 1: 预训练配置 (只有KGE + Rule) ==========",
    "batch_size": 256,
    "negative_sample_size": 512,
    "rule_batch_size": 256,
    "rule_negative_size": 128,
    "hidden_dim": 2000,
    "gamma_fact": 6,
    "gamma_rule": 8,
    "negative_adversarial_sampling": true,
    "adversarial_temperature": 0.25,
    "uni_weight": false,
    "learning_rate": 0.0001,
    "warm_up_steps": null,
    "regularization": 0,
    "disable_adv": false,
    "p_norm": 2,
    "save_checkpoint_steps": 10,
    "valid_steps": 1000,
    "log_steps": 100,
    "weight_rule": 1,
    "max_steps": 30000,
    "init_checkpoint": null,
    "save_path": "umls_SSRL",
    "weight_decay": 0,

    "_comment_grounding": "========== Grounding配置 (原始RulE模式使用) ==========",
    "mlp_rule_dim": 100,
    "smoothing": 0.2,
    "batch_per_epoch": 1000000,
    "print_every": 10,
    "g_batch_size": 16,
    "g_lr": 0.0001,
    "num_iters": 20,

    "_comment_phase2": "========== Phase 2: 策略网络训练配置 ==========",
    "use_policy_network": true,
    "max_num_actions": 200,
    "policy_hidden_dim": 128,
    "policy_num_iters": 20,
    "policy_batch_size": 32,
    "policy_lr": 0.0001,
    "policy_log_steps": 100,
    "max_path_length": 3,

    "_comment_phase3": "========== Phase 3: 测试配置 (KGE + Policy 融合) ==========",
    "num_policy_samples": 10,
    "alpha": 0.5,
    "beta": 0.5
}

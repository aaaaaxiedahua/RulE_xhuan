{
    "data_path": "../data/kinship",
    "rule_file": "../data/kinship/mined_rules.txt",
    "cuda": true,
    "cpu_num": 10,
    "seed": 800,
    "batch_size": 256,
    "negative_sample_size": 512,
    "rule_batch_size": 256,
    "rule_negative_size": 128,
    "hidden_dim": 2000,
    "gamma_fact": 6,
    "gamma_rule": 5,
    "negative_adversarial_sampling": true,
    "adversarial_temperature": 0.25,
    "uni_weight": false,
    "learning_rate": 0.0001,
    "warm_up_steps": null,
    "save_checkpoint_steps": 10,
    "valid_steps": 1000,
    "log_steps": 100,
    "weight_rule": 3,
    "max_steps": 35000,
    "init_checkpoint": null,
    "save_path": "kinship",
    "mlp_rule_dim": 100,
    "p_norm": 2,
    "regularization": 0.1,
    "disable_adv": false,
    "alpha": 3.0,
    "smoothing": 0.2,
    "batch_per_epoch": 1000000,
    "print_every": 10,
    "g_batch_size": 32,
    "g_lr": 0.0005,
    "weight_decay": 0,
    "num_iters": 5,
    "num_samples": 5,
    "beta_kl": 0.001,
    "beta_sigma": 0.0005,
    "lambda_0": 2.0,
    "lambda_uncertainty": 0.0005,

    "use_query_attention": true,
    "attention_hidden_dim": 64,
    "attention_dropout": 0.1,

    "use_hierarchical_agg": true,
    "quality_thresholds": [0.4, 0.7],
    "hierarchical_hidden_dim": 64,
    "hierarchical_dropout": 0.1,

    "calibrate_gate": true,
    "gate_epochs": 5,
    "gate_lr": 0.001,
    "gate_weight_decay": 0.001,
    "gate_neg_size": 128,
    "gate_topk": 50,
    "gate_mlp_hidden_dim": 32,
    "gate_dropout": 0.3,
    "gate_log_steps": 100,
    "gate_score_norm": "zscore",
    "gate_norm_eps": 1e-6,
    "gate_patience": 3,
    "gate_min_improvement": 0.001
}
